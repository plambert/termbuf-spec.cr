/docs/
/lib/
/bin/
/.shards/
*.dwarf

# Libraries don't need dependency lock
# Dependencies will be locked in applications that use them
/shard.lock

# Built by scripts/build-libghostty-vt.sh. No trailing slash on vendor/build:
# it is a symlink into the machine cache, and a trailing slash matches only a
# directory.
/vendor/build
/vendor/.source/
/src/termbuf-spec/libghostty/link.cr

# Stray objects extracted from the static library during a link
/*.o

# Scratch programs used while developing; not part of the shard
/tmp/

# Spectator remembers which examples failed last run
/.spectator-failures

